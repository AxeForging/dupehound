          "lines": [
            "def load_settings(path, env):",
            "    raw = read_file(path)",
            "    data = parse_yaml(raw)",
            "    for key, value in env.items():",
            "        if key.startswith(\"APP_\"):",
            "            data[key[4:].lower()] = value",
            "    validate(data)",
            "    log.info(\"loaded settings\", path=path, keys=len(data))",
            "    return data"
          ]
